# The private deploy config for deploy.sh, record-service-setup.sh and domain.sh
# (deploy/cloud-run/config.sh). Copy it outside every checkout, fill in every
# value, and name the copy in ANTWAR_DEPLOY_CONFIG. Each line is NAME=value with
# no quotes; there are no defaults, and a mode stops before any change, naming
# each setting it needs that is missing.

# The gcloud account and the Google Cloud project every call names; the project
# is also the shared store's project (GCLOUD_PROJECT) on the game and slot servers.
# For a Cloud Build run (cloudbuild.yaml) ACCOUNT is the deploy service account
# the build runs as, and the build refuses any other identity.
ACCOUNT=
PROJECT=
# Cloud Build's source and log bucket (a bare name, without gs://) and identity.
BUILD_BUCKET=
BUILD_SA=
# The game and slot servers' identity, and the record service's.
RUN_SA=
RECORDS_SA=
# The record service's private input bucket and the replay bucket (bare names).
RECORD_INPUT_BUCKET=
REPLAY_BUCKET=
# The game service's own https://...run.app address, compared with
# https://antwars.ai after an `all` deploy.
GAME_SERVICE_URL=
