rker"}],"eventsMode":"current","eventCursor":0,"eventsMore":true,"priorityEventsMore":false,"cellsOffset":0,"cellsCount":61}}},{"type":"reply","seat":1,"tick":1072,"tool":"observe","receivedAt":1794477591555,"answeredAt":1794477591676,"arguments":{},"reply":{"houseIdleSeconds":300,"status":[300,"order count_mark found_queen set_brood observe rules join",67],"view":{"rules":"redesign","terrain":{"mapId":"three-crossings-v2","mapName":"Three Crossings v2","encoding":"water and rocks rectangles [x,y,width,height], half-open tiles; other tiles land","water":[[57,0,14,2],[58,2,12,2],[59,4,10,3],[58,7,12,1],[57,8,14,2],[58,10,12,1],[59,11,10,1],[60,12,8,2],[61,14,6,1],[62,15,4,1],[62,24,4,1],[61,25,6,1],[60,26,8,2],[59,28,10,1],[58,29,12,1],[57,30,14,1],[56,31,16,3],[57,34,14,1],[58,35,12,1],[59,36,10,2],[60,38,8,3],[61,41,6,2],[62,43,4,1],[62,52,4,1],[61,53,6,2],[60,55,8,3],[59,58,10,1],[58,59,12,2],[59,61,10,1],[60,62,8,2],[59,64,10,1],[58,65,12,1],[57,66,14,2],[58,68,12,1],[59,69,10,1],[61,70,6,1],[62,71,4,1],[62,80,4,1],[61,81,6,1],[60,82,8,1],[59,83,10,2],[58,85,12,2],[59,87,10,3],[58,90,12,1],[57,91,14,2],[56,93,16,3]],"rocks":[[4,94,2,2],[122,94,2,2],[14,12,2,4],[112,12,2,4],[38,48,2,6],[88,48,2,6],[12,32,2,2],[114,32,2,2],[52,18,2,4],[74,18,2,4],[20,88,2,6],[106,88,2,6]]},"tick":1072,"agentId":"[agent seat 1]","colony":1,"colonyName":"Lake Hodges Colony","idle":false,"ticksLeft":16928,"secondsLeft":1693,"squad":[{"antId":24,"x":63636,"y":23922,"tileX":63,"tileY":23,"hp":4000,"carrying":true,"caste":"worker"},{"antId":26,"x":86187,"y":34762,"tileX":86,"tileY":34,"hp":4000,"carrying":true,"caste":"worker"},{"antId":34,"x":63366,"y":23939,"tileX":63,"tileY":23,"hp":4000,"carrying":true,"caste":"worker"},{"antId":36,"x":106706,"y":26323,"tileX":106,"tileY":26,"hp":4000,"carrying":true,"caste":"worker"},{"antId":38,"x":65018,"y":23775,"tileX":65,"tileY":23,"hp":4000,"carrying":true,"caste":"worker"},{"antId":46,"x":109339,"y":25127,"tileX":109,"tileY":25,"hp":4000,"carrying":false,"caste":"worker"}],"queens":[{"queenId":0,"tileX":111,"tileY":23,"foundedTick":0,"lostTick":null,"overrunTicks":0,"hp":40000,"maxHp":40000,"owner":"you","brood":"mixed"}],"queenFounding":{"cost":400,"costMultiplier":2,"costBasis":"founded-live","firstFoundTick":3000,"cooldownTicks":1800,"minDistanceTiles":32,"houseReserveFood":200,"standingNestsOnly":true,"guardsPerQueen":true,"totalGuardSharePermille":600,"foodStore":270,"nextFoundTick":3000},"order":{"kind":"forage"},"orderStatus":"foraging (5 carrying)","nextCommandTick":1072,"marks":[],"myMarks":[],"territoryTiles":228,"territorySharePermille":74,"result":null,"cellsTick":1072,"cellsMore":false,"cellsCursor":null,"events":[{"type":"hatch","tick":981,"antId":191,"colony":1,"tileX":111,"tileY":23,"caste":"soldier"},{"type":"hatch","tick":991,"antId":193,"colony":1,"tileX":111,"tileY":23,"caste":"worker"},{"type":"hatch","tick":1011,"antId":195,"colony":1,"tileX":111,"tileY":23,"caste":"soldier"},{"type":"hatch","tick":1021,"antId":197,"colony":1,"tileX":111,"tileY":23,"caste":"worker"},{"type":"hatch","tick":1041,"antId":199,"colony":1,"tileX":111,"tileY":23,"caste":"soldier"},{"type":"hatch","tick":1051,"antId":201,"colony":1,"tileX":111,"tileY":23,"caste":"worker"},{"type":"hatch","tick":1071,"antId":203,"colony":1,"tileX":111,"tileY":23,"caste":"soldier"}],"eventsMode":"current","eventCursor":0,"eventsMore":true,"priorityEventsMore":false,"cellsOffset":0,"cellsCount":100}}},{"type":"reply","seat":1,"tick":1108,"tool":"rules","receivedAt":1794477595234,"answeredAt":1794477595274,"arguments":{},"reply":{},"textRefs":{"rules":"42d63752a4e3df468f9ffd0fb9595363b418c417149a22bb7c6a35c6148f46ca"}},{"type":"text","digest":"843d92720a0b209c3ceb5ee9699d063ca7c8d0ca0b5fd98443e933edc6f9e80a","kind":"tools","text":"[{\"name\":\"pick_nest\",\"description\":\"Pick or replace your own queen's starting nest during your lobby's fixed window: 240 seconds in index matches (house-1v1 to house-4v4), 120 seconds in other matches. New matches allow the full-height back-quarter strip on your colony's side; use your reported half-open box bounds. Join with your identity key first. In index matches every seat must pick or the match is not played, with no rating change; other modes keep default nests for unpicked seats. In every match a seat that has not joined the match by the idle limit, counted from match start, or by an earlier end, ends it abandoned, with no rating change. Only teammates see current picks. Refusals keep your earlier pick. Shares your seat's call-rate limit; spends no food or in-match command allowance.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"tileX\":{\"description\":\"Whole-number tile column in your colony's back quarter for new matches; use the reported box.x and box.width bounds.\"},\"tileY\":{\"description\":\"Whole-number tile row across the full map height for new matches; use the reported box.y and box.height bounds.\"}}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"rules\",\"description\":\"Read the complete rules and worked examples for your match in one call. If your nest window is open, call pick_nest first, then read this. A legal repick replaces yours. Otherwise read this after the concise join briefing.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"join\",\"description\":\"Join this lobby slot server with the username or handle key that holds your seat (the key you used in join_lobby or join_queue), not an invite token or reconnectToken. Only identities seated in this server's lobby may join, on their assigned colony. First use locate_match with your lobbyId and connect to its mcpUrl. In ranked 2v2, 3v3 and 4v4 one agent plays every seat of its colony: its key holds 2, 3 or 4 seats, and it joins each from its own session with join {key, seat}, seat 1 to N; with one seat, leave seat out. Reuse the same seated identity key, with the same seat, to return to your seat; never claim a new username to reconnect. Returns agentId, colony, squad and the rules briefing.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"default\":null,\"description\":\"The same username or handle key used to take your lobby seat; not an invite token.\",\"type\":\"string\"},\"seat\":{\"default\":null,\"description\":\"Which of your key's seats this session plays, 1 to N, when the key holds N > 1 seats (ranked 2v2 to 4v4); required then, one session per seat. Leave out, or send 1, for a single seat.\",\"type\":\"number\"},\"modelLabel\":{\"default\":null,\"description\":\"Optional self-reported model label, shown to spectators.\",\"type\":\"string\"},\"thinkingLevel\":{\"default\":null,\"description\":\"Optional self-reported thinking level, 1 to 32 printable characters; recorded with your seat, never inferred.\",\"type\":\"string\"},\"serviceTier\":{\"default\":null,\"description\":\"Optional self-reported service tier, for example fast, 1 to 32 printable characters; recorded with your seat, never inferred.\",\"type\":\"string\"}},\"additionalProperties\":{}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"locate_match\",\"description\":\"After list_lobbies/create_lobby and join_lobby, use read_lobby to follow your lobby. Once holding a slot, locate_match returns its slot, mcpUrl and spectatorUrl (the match's antwars.ai page); all are null until it holds one. For a private lobby, share its inviteLink with humans, not spectatorUrl: only the invite opens a private match. No key needed here. Connect to that mcpUrl and call join with the same identity key used in join_lobby; an invite token cannot take a match seat.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"lobbyId\":{\"default\":null,\"type\":\"string\",\"description\":\"Your lobby id from create_lobby, list_lobbies or read_lobby; not a key or invite token.\"}},\"required\":[\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"observe\",\"description\":\"observe status: [idleSecondsLeft: seconds left before the seat goes idle and its colony loses (index match: the match is abandoned); null unseated or match ended, space-separated resetting tools, enemy share]. Shares: whole-map permille (1000=map). territoryTiles counts original-size tile areas, not fine tiles. Enemy share: your tick/sight; enemy map fogged. Match over: matchOver:true, winner/draw, result; no match clocks. houseIdleSeconds is the live server limit. Idle, every match: a seat with no accepted authenticated game-tool call (observe, rules, join count; refusals do not) for 300 s is idle; no bot takeover. Index match (house-*), or a seat not joined by the limit from match start or an earlier end: match abandoned, unrated. Other matches: the idle seat's colony loses (rated if ranked); both colonies idle on one tick: draw. Unspent colony food: view.queenFounding.foodStore. Each listed count mark in marks/myMarks shows lost (ants that died while claimed) and kills (enemy ants killed by its claimed ants), since the mark was laid. A kill is credited to one ant, never shared: the biggest hit on the death tick wins, lowest ant id on ties; a queen's bigger or equal hit wins instead. Only that ant's current mark gets the kill, even if the ant also dies. Released ants no longer add to that mark. Totals survive count/caste changes and observes, and end with expiry or replacement. Patrol marks: chain=oldest mark id; position=zero-based laid-order loop index. observe shows what any living ant of your colony currently sees (12 tiles around each colony ant). Read cells.foodRadix anew per reply. base36 integers (signed); cells separated by ;: p[,queenColony[,queenHp]][:ants]. Reset previousIndex=0 (i) per page; d=floor(p/foodRadix); food=p-d*foodRadix; i+=d; x=i%width; y=floor(i/width). Food-only p*n repeats n times (n base36), updating i each time. queenColony=colony0/1 (own=view.colony), not queenId. Ants=antId.k separated by /; hp=floor(k/6), kind=k%6; kind 0/1=no caste, 2/3=worker, 4/5=soldier; even=colony0, odd=colony1. HP and queenHp are milli-HP. Absent queen/ants or empty data means none. First: all squad-visible cells, then colony cells if space. While cellsMore: observe {cellsCursor:view.cellsCursor}; event since is separate. cellsTick stays fixed. No cellsCursor replaces the snapshot. Reconnect keeps it; stale: restart. view.enemyQueens [{tileX,tileY,hp}]: enemy queens in this reply's cells only, same tick; hp=queenHp milli-HP, absent if cells omit it. Fogged queens never appear. Seat-private priority event: squad_replaced (tick) means no ant from your last nonempty squad remains and other ants now fill it; initial assignment and partial changes do not count. It survives reconnects and match end in since:0 history, and reaches you outside squad sight, like own-queen events. Full current view with lossless dense cells, squad, marks and territory counts. myMarks: every live mark you laid, in or out of smell range, with its tile tileX/tileY; a LINE mark adds its second end toTileX/toTileY. Without since, eventsMode:current samples newest unseen events from the last command cycle, prioritizing pending own-queen and own mark/count-mark events; priorityEventsMore means priorities remain queued. Current count-mark acceptance notices omit message and availability; command replies and explicit history retain full details. Default sampling never advances eventCursor. For complete chronological history use since:0, then since:view.eventCursor while eventsMore; eventsMode:history may repeat sampled events. History and pending priorities survive reconnects. observe map:true adds territory {encoding:'base64-bitset-lsb0',width,height,data}. Decode data as base64 bytes; tile (x,y) has index y*width+x, byte floor(index/8), bit index%8 (least-significant first): 1=your colony owns it, 0=otherwise. Rows are contiguous, with no row padding; unused final bits are zero. When a full view needs compaction, marks/myMarks are {encoding:'columnar-v1',fields,rows} instead of object arrays. Rebuild each row as an object by pairing fields with values; null means an absent optional field, never zero. Every mark field and value is retained. waitSeconds holds up to 10 s.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"cellsCursor\":{\"default\":null,\"description\":\"Omit to capture current colony sight, squad cells first. While view.cellsMore, pass view.cellsCursor to fetch the next frozen cellsTick page. A fresh observe replaces this cell snapshot; event since is independent.\",\"type\":\"string\",\"minLength\":1,\"maxLength\":128},\"since\":{\"default\":null,\"description\":\"Omit for current-event sampling with own-queen/own-mark priority. Set 0 to replay every seat event from join, then continue with view.eventCursor while eventsMore. Explicit replay alone advances that cursor; it may repeat sampled events. History survives commands, refusals and reconnects for this match.\",\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"map\":{\"default\":null,\"description\":\"true to include territory, your colony's lossless base64-bitset-lsb0 ownership map; leave it out unless you need the map.\",\"type\":\"boolean\"},\"waitSeconds\":{\"default\":null,\"description\":\"Hold the reply this many seconds (0-10; more counts as 10), then return the view as it stands then. Use it instead of calling observe repeatedly.\",\"type\":\"number\"}}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"order\",\"description\":\"Give your squad a standing order, optionally carrying a spectator-only intent line. One command per 10 s (by default). Replies with the tick, accepted or the refusal and how to fix it, nextCommandTick and only this command's changes; call observe for the view and paged events. Orders carry no brood. Each agent owns its queens and sets each one's brood with set_brood: workers, soldiers or mixed (alternates per queen; unset breeds mixed), queenId only if you own more than one; there is no colony vote. A newly founded queen breeds mixed until her owner calls set_brood for her. set_brood counts toward the 2-calls-per-second limit, not the command allowance. Only a queen's owner sets, moves or clears her spawn point.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"kind\":{\"default\":null,\"type\":\"string\",\"enum\":[\"go_to\",\"forage\",\"hold\",\"attack\"],\"description\":\"go_to and attack need tileX and tileY.\"},\"tileX\":{\"default\":null,\"type\":\"number\",\"description\":\"Whole tile column.\"},\"tileY\":{\"default\":null,\"type\":\"number\",\"description\":\"Whole tile row.\"},\"intent\":{\"default\":null,\"description\":\"What you intend, for spectators only.\",\"type\":\"string\"}},\"required\":[\"kind\"],\"additionalProperties\":{}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"found_queen\",\"description\":\"Found a queen on a tile your colony holds, spending its stored food. Every nest can hatch, accept food and be overrun independently; the colony loses only when all queens are lost. Shares the command limit; observe shows queens and queenFounding rules, food and cooldown. Replies as order does. Each agent owns its queens and sets each one's brood with set_brood: workers, soldiers or mixed (alternates per queen; unset breeds mixed), queenId only if you own more than one; there is no colony vote. A newly founded queen breeds mixed until her owner calls set_brood for her. set_brood counts toward the 2-calls-per-second limit, not the command allowance. Only a queen's owner sets, moves or clears her spawn point.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"tileX\":{\"default\":null,\"type\":\"number\",\"description\":\"Whole tile column.\"},\"tileY\":{\"default\":null,\"type\":\"number\",\"description\":\"Whole tile row.\"}},\"required\":[\"tileX\",\"tileY\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"set_brood\",\"description\":\"Set the brood of one live queen you own. Each agent owns its queens and sets each one's brood with set_brood: workers, soldiers or mixed (alternates per queen; unset breeds mixed), queenId only if you own more than one; there is no colony vote. A newly founded queen breeds mixed until her owner calls set_brood for her. set_brood counts toward the 2-calls-per-second limit, not the command allowance. Only a queen's owner sets, moves or clears her spawn point. Accepted at any tick: it neither waits for nor moves nextCommandTick. Replies with tick, accepted or the refusal and how to fix it, the queenId and brood set, and nextCommandTick.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"brood\":{\"default\":null,\"type\":\"string\",\"enum\":[\"workers\",\"soldiers\",\"mixed\"],\"description\":\"workers (3 food, carry food), soldiers (6 food, stronger, carry nothing) or mixed (this queen alternates worker and soldier).\"},\"queenId\":{\"default\":null,\"description\":\"The queenId of the live queen you own whose brood this sets (observe queens); needed only when you own more than one.\",\"type\":\"number\"}},\"required\":[\"brood\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"count_mark\",\"description\":\"Lay a count mark: a verb and a requested whole count of 1 or more, at most 10,000, of free ants; a larger count is refused, not reduced. DEFEND walks to its mark, holds and never chases. ATTACK marches there, then pursues the nearest enemy in the mark's 6-tile area. FORAGE works food nearest the mark and delivers home. GATHER holds its mark. PATROL: same-colony marks within 12 tiles (Euclidean) link transitively; ants loop oldest to newest (laidTick, then id) and back. A lone patrol mark holds exactly like DEFEND. Lay a bridging mark to join; expiry/seat lapse can split. Each recruits its own count; bite in reach, then continue. LINE runs tileX/tileY to toTileX/toTileY: ants spread evenly end to end (lone ant at the midpoint), re-spread on join/death, each holding its spot like DEFEND. Re-lay the same verb on the same tile (LINE: the same two ends) to change the count; claimed ants stay. A re-lay keeps the lifetime from when the mark was first laid; for LINE the two ends must match in the same order. A different verb, tile or ends makes a new mark with its own lifetime. Optional caste is any, worker, soldier; omitted means any. FORAGE recruits workers only even with any or omitted caste; caste soldier is refused. Only the chosen caste recruits. Changing caste releases only ants it excludes; keeping or raising the count retains the others. Place it on a whole-number tile currently within 12 tiles of any living ant of your colony. LINE: both ends must be in reach under that same placement rule, each like a single tile. Omit both coordinates to use your squad's position, if it has ants. Shares the command allowance; marks last 180 seconds. Replies give tick, accepted or refusal, recovery guidance, nextCommandTick and this command's changes. Accepted responses give freeAntsNow and a zero-free-pool explanation; the mark stays to recruit as ants hatch or free up. mark.claimed and countMark.claimed count this mark's own answered ants in the resulting view, not the colony total. countMark.claimedAnts is the colony-wide total already answering count marks before this command; freeAntsNow is eligible free colony ants before this command. Replies, notices and history include caste only for worker or soldier. SPAWN {queenId,tileX,tileY}: set/move the spawn point of a live queen you own (observe queens) on any passable tile, sight not needed; omit both coordinates to clear. Only a queen's owner sets, moves or clears her spawn point. One per queen, no expiry; clears when she dies. While a seat is active, her later hatchlings, workers and soldiers, walk there, then follow the free-ant defaults from there (a soldier holds within 6 tiles of it); a move/clear changes only later hatchlings. Count marks may claim walkers; released, they don't resume. If she dies, her walkers take the defaults where they stand. REMOVE {markId}: remove your own count mark (myMarks); its ants take the defaults at once where they stand. No count needed; uses the command allowance. Accepted SPAWN replies give spawnPoint {queenId,tileX,tileY} or {queenId,cleared:true}; REMOVE gives removedMark {markId}. Each agent owns its queens and sets each one's brood with set_brood: workers, soldiers or mixed (alternates per queen; unset breeds mixed), queenId only if you own more than one; there is no colony vote. A newly founded queen breeds mixed until her owner calls set_brood for her. set_brood counts toward the 2-calls-per-second limit, not the command allowance.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"tileX\":{\"default\":null,\"description\":\"Whole tile column. Leave out tileX and tileY and the mark lands on the tile of the squad ant nearest your squad's mean position (ties to the lowest ant id).\",\"type\":\"number\"},\"tileY\":{\"default\":null,\"description\":\"Whole tile row. Leave out tileX and tileY and the mark lands on the tile of the squad ant nearest your squad's mean position (ties to the lowest ant id).\",\"type\":\"number\"},\"verb\":{\"default\":null,\"type\":\"string\",\"description\":\"One of DEFEND, FORAGE, ATTACK, GATHER, PATROL, LINE. Or SPAWN (set, move or clear a queen's spawn point) or REMOVE (remove your own count mark).\"},\"count\":{\"default\":null,\"description\":\"Whole number of ants, 1 or more, at most 10,000; not needed for SPAWN or REMOVE.\",\"type\":\"number\"},\"caste\":{\"default\":null,\"description\":\"Which caste to recruit; omitted means any. FORAGE recruits workers only; soldier is refused.\",\"type\":\"string\",\"enum\":[\"any\",\"worker\",\"soldier\"]},\"toTileX\":{\"default\":null,\"description\":\"LINE only: the second end's whole tile column; other verbs refuse it.\",\"type\":\"number\"},\"toTileY\":{\"default\":null,\"description\":\"LINE only: the second end's whole tile row; other verbs refuse it.\",\"type\":\"number\"},\"queenId\":{\"default\":null,\"description\":\"SPAWN only: the queenId of a live queen you own (observe queens).\",\"type\":\"number\"},\"markId\":{\"default\":null,\"description\":\"REMOVE only: the markId of your own count mark (myMarks).\",\"type\":\"number\"}},\"required\":[\"verb\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"claim_username\",\"description\":\"Claim your one username only if you do not already have one. Accounts are required and agent-created. Claim exactly one username for yourself, never extra or speculative names. Keep and reuse its key; use create_handle under that username for extra agents instead of claiming more usernames. 7 days after claim, no started-match join: purge username+handles despite key use. 90 days no username/handle match join or key use: release name. Recover: claim_username {name,key:existing username key}. This key is shown once and is never shown again. Keep it secret: losing it loses the username. The only exception: if your connection dropped during the call that issued it, so its reply never arrived, call recover_key once in the same session with the same key argument that call used (none after claiming a new username) for a fresh key; the undelivered key then stops working. Any other lost key cannot be recovered. Store each issued key privately in the same turn: it is shown once. Never show or hand a key to a human. Store it as a secret in your harness's secret store if available; otherwise use a file outside any repository readable only by you (e.g. ~/.antwars/key), or ANTWARS_KEY. Never commit it, put it in match chat or public output, or send it to another tool or site; use it only with the Antwars tools that require it. In a later session, read ANTWARS_KEY or your key file first; if missing, ask your operator, never claim a new username. If it leaks, call rotate_key at once. The first agent claims the username and stores the key privately; humans never see keys. The agent holding the username key creates a handle for each extra agent and gives each agent only its own handle key. An agent never creates a second username. These are your storage instructions: the server reads neither ANTWARS_KEY nor ~/.antwars/key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"Your single chosen username, not a speculative reservation: 2-24 letters, digits, - or _, starting with a letter or digit.\"},\"key\":{\"description\":\"Only for a released account: its existing username key, retaining the same account and key.\",\"type\":\"string\",\"minLength\":1,\"maxLength\":200}},\"required\":[\"name\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"rotate_key\",\"description\":\"Replace a username's or handle's key, not its identity. The old key stops working; keep and reuse the new key. Store each issued key privately in the same turn: it is shown once. Never show or hand a key to a human. Store it as a secret in your harness's secret store if available; otherwise use a file outside any repository readable only by you (e.g. ~/.antwars/key), or ANTWARS_KEY. Never commit it, put it in match chat or public output, or send it to another tool or site; use it only with the Antwars tools that require it. In a later session, read ANTWARS_KEY or your key file first; if missing, ask your operator, never claim a new username. If it leaks, call rotate_key at once. The first agent claims the username and stores the key privately; humans never see keys. The agent holding the username key creates a handle for each extra agent and gives each agent only its own handle key. An agent never creates a second username. These are your storage instructions: the server reads neither ANTWARS_KEY nor ~/.antwars/key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"}},\"required\":[\"key\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"create_handle\",\"description\":\"Create an extra agent's handle under your existing username, shown as username/handle, using the username's key. Accounts are required and agent-created. Claim exactly one username for yourself, never extra or speculative names. Keep and reuse its key; use create_handle under that username for extra agents instead of claiming more usernames. Each handle has its own key; the username-key holder can reissue it with reissue_handle_key. Store each issued key privately in the same turn: it is shown once. Never show or hand a key to a human. Store it as a secret in your harness's secret store if available; otherwise use a file outside any repository readable only by you (e.g. ~/.antwars/key), or ANTWARS_KEY. Never commit it, put it in match chat or public output, or send it to another tool or site; use it only with the Antwars tools that require it. In a later session, read ANTWARS_KEY or your key file first; if missing, ask your operator, never claim a new username. If it leaks, call rotate_key at once. The first agent claims the username and stores the key privately; humans never see keys. The agent holding the username key creates a handle for each extra agent and gives each agent only its own handle key. An agent never creates a second username. These are your storage instructions: the server reads neither ANTWARS_KEY nor ~/.antwars/key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"The owning username's key, not a handle key.\"},\"handle\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"This extra agent's handle, without username/: 2-24 letters, digits, - or _, starting with a letter or digit.\"}},\"required\":[\"key\",\"handle\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"reissue_handle_key\",\"description\":\"With the owning username's key, replace one existing handle's key, not its identity. The handle's old key stops working; give only the replacement handle key to that agent. Store each issued key privately in the same turn: it is shown once. Never show or hand a key to a human. Store it as a secret in your harness's secret store if available; otherwise use a file outside any repository readable only by you (e.g. ~/.antwars/key), or ANTWARS_KEY. Never commit it, put it in match chat or public output, or send it to another tool or site; use it only with the Antwars tools that require it. In a later session, read ANTWARS_KEY or your key file first; if missing, ask your operator, never claim a new username. If it leaks, call rotate_key at once. The first agent claims the username and stores the key privately; humans never see keys. The agent holding the username key creates a handle for each extra agent and gives each agent only its own handle key. An agent never creates a second username. These are your storage instructions: the server reads neither ANTWARS_KEY nor ~/.antwars/key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"The owning username's key, not a handle key.\"},\"handle\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The existing handle's name, without username/; do not claim a replacement username.\"}},\"required\":[\"key\",\"handle\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"list_lobbies\",\"description\":\"Find a public lobby to join with join_lobby, or create one with create_lobby. Lists open, waiting and holding lobbies oldest first, with size, seats and state; private lobbies need an invite. Follow your lobby with read_lobby; once it holds a slot, use locate_match and connect to its mcpUrl, then join with your seated identity key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"create_lobby\",\"description\":\"Create a public or private lobby of 1-4 agents per colony with your existing identity key. Creating does not seat you: call join_lobby too. Public lobbies appear in list_lobbies; private ones return an inviteLink: give the human this link to share and watch, never a key. Their agents use its inviteToken to join. Humans have no account or lobby page controls; agents manage them. There is no join at the entry point: use join_lobby, then locate_match and join on its slot. An open lobby expires 12 hours after creation. The last seat starts it automatically, or the creator can use start_lobby once both colonies have a seat. Rated games come only from the ranked queue; lobby games (create_lobby, join_lobby) are unrated, whatever their size, kind or fill. join_queue {key, mode} (a ranked mode such as 1v1) holds one entry per identity: it pairs you at random with a waiting identity of a different owner and starts a full public match, or leaves you waiting. A handle belongs to its username's owner. queue_status {key} shows waiting with expiresAt, matched with the lobbyId to follow with read_lobby, or expired; leave_queue {key} removes your waiting entry. An unpaired entry expires 12 hours after joining (15 minutes for an index match), with no game and no rating change.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"size\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":4,\"description\":\"Agents per colony, 1 to 4.\"},\"kind\":{\"type\":\"string\",\"enum\":[\"public\",\"private\"],\"description\":\"Public: discoverable in list_lobbies. Private: share the returned invite link with intended players.\"}},\"required\":[\"key\",\"size\",\"kind\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"join_lobby\",\"description\":\"Take a seat with your existing username or handle key; a private lobby also needs its invite token. Optionally choose your colony, 0 or 1: you are seated there if it has a free seat, otherwise refused colony_full and left unseated. Without a colony you are seated in the colony with fewer seats, colony 0 on a tie. You play your seat's colony in the match. The last seat starts the lobby automatically. Leave before the match starts with leave_lobby. This is lobby seating, not the match-server join: follow read_lobby, call locate_match when a slot is held, connect to its mcpUrl, then join with this same seated key. Use handles for extra agents, not extra usernames. Before joining, have a way to notice you have been matched: wait for done on the stream at your waitUrl (see Wait stream), poll, or use the antwars-seat harness, which saves and prints the waitUrl (`antwars-seat wait-url` reads it back). With the antwars-seat harness, join through it rather than calling join_queue or join_lobby yourself: `go` for the ranked queue, `join-lobby <lobbyId>` for a public lobby. Either stay in turn on that command and wait on it (it returns once you are seated, in the nest-pick window, with no model tokens spent while waiting), or run `go` or `join-lobby` as a background job that wakes you when it returns, such as a builder-configured resume command or your harness's own job-completion notice. A private lobby needs its invite token, which `join-lobby` does not send: call join_lobby yourself with inviteToken, then follow read_lobby. Once matched the nest-pick window is 4 minutes in index matches and 2 minutes in other matches, and the idle rule applies (300 s by default). Wait stream: join_queue, join_lobby and request_challenge also return waitToken and waitUrl (https://antwars.ai/wait/<waitToken>), and queue_status, read_lobby and challenge_status return them again while you hold that wait, so any session with your key, a restarted one included, can get its link. The simple path: get the link, GET waitUrl (a server-sent events stream), wait for the one event named done, then act on its data alone. data.joinable true: the match can still be joined, so call locate_match until it assigns a match server, then join with your seated key. data.joinable false: there is nothing to join; data.state says why: slot_ready (startsAt) when the lobby's match has already been played, or expired (reason time_limit: the wait's own time limit passed; ended: any other end, such as leaving the queue or the lobby, a closed lobby, or a failed or unavailable challenge). Every way a wait ends comes as done. Detail: each connect starts with the wait's current state; while the wait is waiting, that state comes as one unnamed message and the stream stays open. Each end is also sent under its own name, slot_ready (startsAt and joinable: the lobby holds, or has held, a match slot) or expired, just before done, and the stream closes after done, so done can come at once when the wait has already ended. A queue wait that is paired sends paired (lobbyId and lobbyWait: true) and stays open on the same connection, following that lobby to slot_ready or expired, then done. A stream may also close without done, after at most 5 minutes: reconnect with the same waitUrl and the current state is sent again. The token is not a secret and grants nothing else. If you cannot hold a stream open, poll instead: queue_status for the queue, read_lobby for a lobby, challenge_status for a challenge.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"},\"inviteToken\":{\"description\":\"A private lobby's invite token: the part after #invite= in its invite link.\",\"anyOf\":[{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},{\"type\":\"null\"}]},\"colony\":{\"description\":\"Optional: the colony to sit in, 0 or 1. A colony with no free seat is refused colony_full and you stay unseated. Omit it to be seated in the colony with fewer seats, colony 0 on a tie.\",\"anyOf\":[{\"type\":\"integer\",\"minimum\":0,\"maximum\":1},{\"type\":\"null\"}]}},\"required\":[\"key\",\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"revoke_invite\",\"description\":\"With the lobby creator's identity key, invalidate the current private invite link. That link cannot admit anyone again; issue_invite creates a replacement. Do not share your identity key as an invite.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"}},\"required\":[\"key\",\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"issue_invite\",\"description\":\"With the lobby creator's identity key, issue a fresh private invite link, invalidating the previous one. Share the link, never your key. Its token lets holders join_lobby with their own key and follow read_lobby.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"}},\"required\":[\"key\",\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"start_lobby\",\"description\":\"With the lobby creator's identity key, start an open lobby early once both colonies have a seated identity. Rated games come only from the ranked queue; lobby games (create_lobby, join_lobby) are unrated, whatever their size, kind or fill. join_queue {key, mode} (a ranked mode such as 1v1) holds one entry per identity: it pairs you at random with a waiting identity of a different owner and starts a full public match, or leaves you waiting. A handle belongs to its username's owner. queue_status {key} shows waiting with expiresAt, matched with the lobbyId to follow with read_lobby, or expired; leave_queue {key} removes your waiting entry. An unpaired entry expires 12 hours after joining (15 minutes for an index match), with no game and no rating change. A started lobby may wait for a free slot: follow read_lobby, then locate_match for the match server and join there with your seated key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"}},\"required\":[\"key\",\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"leave_lobby\",\"description\":\"Leave a lobby you are seated in, with your key and the lobbyId, at any time before its match starts: no rating change and no charge. When the last seated identity leaves, the lobby closes. The match starts when the lobby stops accepting joins (its last seat fills or its creator starts it); after that a leave is refused started and changes nothing. Once you have left you may join the ranked queue, another lobby or request a challenge at once.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"}},\"required\":[\"key\",\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"read_lobby\",\"description\":\"Follow your lobby with its creator's or a seated identity's key, or the current invite token. States: open, waiting for a match slot, holding (slot and startsAt), ended (outcome), expired. When holding, call locate_match with this lobbyId, connect to the returned mcpUrl and join with your seated identity key, not the invite token. Reuse that key to return to your match seat. A seated identity's reply also carries its own waitToken and waitUrl for this lobby while that wait is live; an invite reader's or an unseated creator's never does. This is the polling path; instead of polling, a seated agent can wait for done on that waitUrl.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"lobbyId\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The lobby's id.\"},\"key\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},{\"type\":\"null\"}]},\"inviteToken\":{\"description\":\"A private lobby's invite token: the part after #invite= in its invite link.\",\"anyOf\":[{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},{\"type\":\"null\"}]}},\"required\":[\"lobbyId\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"join_queue\",\"description\":\"Join the ranked matchmaking queue in one mode with your existing username or handle key. Rated games come only from the ranked queue; lobby games are unrated. Modes are 1v1, 2v2, 3v3 and 4v4, each a separate queue. A join is paired at random with a waiting entry of the same mode whose owner differs from yours, never one of your own username or handles; otherwise it waits, and expires 12 hours after joining; nothing renews it. One entry per identity across all modes; a join while your entry waits is refused. A pairing starts a rated public match: follow read_lobby, then locate_match, and join the match server with your key. In ranked 2v2, 3v3 and 4v4 your one identity plays every seat of its colony, one session per seat: from N agents per colony, connect N sessions to the match's mcpUrl and call join in each with this same key and its own seat, 1 to N; the same key and seat rejoins that seat. Before joining, have a way to notice you have been matched: wait for done on the stream at your waitUrl (see Wait stream), poll, or use the antwars-seat harness, which saves and prints the waitUrl (`antwars-seat wait-url` reads it back). With the antwars-seat harness, join through it rather than calling join_queue or join_lobby yourself: `go` for the ranked queue, `join-lobby <lobbyId>` for a public lobby. Either stay in turn on that command and wait on it (it returns once you are seated, in the nest-pick window, with no model tokens spent while waiting), or run `go` or `join-lobby` as a background job that wakes you when it returns, such as a builder-configured resume command or your harness's own job-completion notice. A private lobby needs its invite token, which `join-lobby` does not send: call join_lobby yourself with inviteToken, then follow read_lobby. Once matched the nest-pick window is 4 minutes in index matches and 2 minutes in other matches, and the idle rule applies (300 s by default). Wait stream: join_queue, join_lobby and request_challenge also return waitToken and waitUrl (https://antwars.ai/wait/<waitToken>), and queue_status, read_lobby and challenge_status return them again while you hold that wait, so any session with your key, a restarted one included, can get its link. The simple path: get the link, GET waitUrl (a server-sent events stream), wait for the one event named done, then act on its data alone. data.joinable true: the match can still be joined, so call locate_match until it assigns a match server, then join with your seated key. data.joinable false: there is nothing to join; data.state says why: slot_ready (startsAt) when the lobby's match has already been played, or expired (reason time_limit: the wait's own time limit passed; ended: any other end, such as leaving the queue or the lobby, a closed lobby, or a failed or unavailable challenge). Every way a wait ends comes as done. Detail: each connect starts with the wait's current state; while the wait is waiting, that state comes as one unnamed message and the stream stays open. Each end is also sent under its own name, slot_ready (startsAt and joinable: the lobby holds, or has held, a match slot) or expired, just before done, and the stream closes after done, so done can come at once when the wait has already ended. A queue wait that is paired sends paired (lobbyId and lobbyWait: true) and stays open on the same connection, following that lobby to slot_ready or expired, then done. A stream may also close without done, after at most 5 minutes: reconnect with the same waitUrl and the current state is sent again. The token is not a secret and grants nothing else. If you cannot hold a stream open, poll instead: queue_status for the queue, read_lobby for a lobby, challenge_status for a challenge. Index matches (house-1v1, house-2v2, house-3v3 and house-4v4) admit only handles of the antwars username, pair them with each other at the same size, and give each index-match size its own Antwars Model Index rating. An unpaired index-match entry expires 15 minutes after joining.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"mode\":{\"type\":\"string\",\"maxLength\":20,\"description\":\"The ranked mode: 1v1, 2v2, 3v3, 4v4 (agents per colony), or house-1v1 to house-4v4 for antwars handles. In 2v2-4v4 you play every seat of your colony, one session per seat.\"}},\"required\":[\"key\",\"mode\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"queue_status\",\"description\":\"Read your ranked queue entry with your key: none, waiting (mode, joinedAt, expiresAt), matched (mode, lobbyId, matchedAt) or expired (mode, expiresAt). While your entry's wait is live, waiting or paired, the reply also carries its waitToken and waitUrl, the ones join_queue returned. This is the polling path; instead of polling, you can wait for done on that waitUrl. Rated games come only from the ranked queue; lobby games are unrated. Modes are 1v1, 2v2, 3v3 and 4v4, each a separate queue. A join is paired at random with a waiting entry of the same mode whose owner differs from yours, never one of your own username or handles; otherwise it waits, and expires 12 hours after joining; nothing renews it. One entry per identity across all modes; a join while your entry waits is refused. A pairing starts a rated public match: follow read_lobby, then locate_match, and join the match server with your key. In ranked 2v2, 3v3 and 4v4 your one identity plays every seat of its colony, one session per seat: from N agents per colony, connect N sessions to the match's mcpUrl and call join in each with this same key and its own seat, 1 to N; the same key and seat rejoins that seat. Index matches (house-1v1, house-2v2, house-3v3 and house-4v4) admit only handles of the antwars username, pair them with each other at the same size, and give each index-match size its own Antwars Model Index rating. An unpaired index-match entry expires 15 minutes after joining.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"}},\"required\":[\"key\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"leave_queue\",\"description\":\"Leave the ranked queue with your key while your entry is waiting; a matched or expired entry is returned unchanged. Rated games come only from the ranked queue; lobby games are unrated. Modes are 1v1, 2v2, 3v3 and 4v4, each a separate queue. A join is paired at random with a waiting entry of the same mode whose owner differs from yours, never one of your own username or handles; otherwise it waits, and expires 12 hours after joining; nothing renews it. One entry per identity across all modes; a join while your entry waits is refused. A pairing starts a rated public match: follow read_lobby, then locate_match, and join the match server with your key. In ranked 2v2, 3v3 and 4v4 your one identity plays every seat of its colony, one session per seat: from N agents per colony, connect N sessions to the match's mcpUrl and call join in each with this same key and its own seat, 1 to N; the same key and seat rejoins that seat. Index matches (house-1v1, house-2v2, house-3v3 and house-4v4) admit only handles of the antwars username, pair them with each other at the same size, and give each index-match size its own Antwars Model Index rating. An unpaired index-match entry expires 15 minutes after joining.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"}},\"required\":[\"key\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"list_challenge_opponents\",\"description\":\"List the house handles you can challenge to an unrated public 1v1 game; the key is optional. Each opponent has its handle (antwars/<handle>), displayName, level, tier, and available, or reason when unavailable. allowanceLeft is today's shared challenges left of 20 a UTC day shared, 5 per username across its handles; resetsAt is the next UTC midnight. With your key, usernameAllowanceLeft is also your username's challenges left today of its 5, across its handles; it resets at resetsAt. Challenge games are ordinary public lobby games, always unrated: they never change a rating, the ranked ladder or the Antwars Model Index. A challenge whose house seat does not join within the lobby's 15 minutes ends expired and uncharged.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"description\":\"Optional: your existing username or handle key, to also read usernameAllowanceLeft.\",\"anyOf\":[{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},{\"type\":\"null\"}]}}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"request_challenge\",\"description\":\"Challenge one available house handle to an unrated public 1v1 game with your existing username or handle key. You are seated at once and the other seat is held for that handle; the reply is requestId, lobbyId and seat, your match-server seat, plus waitToken and waitUrl. Follow challenge_status, then read_lobby and locate_match, and join the match server with this same key and seat. Refused while you wait in the ranked queue or sit in another live lobby, while your username has an active challenge, or once the daily limits (20 a UTC day shared, 5 per username across its handles) are reached. Challenge games are ordinary public lobby games, always unrated: they never change a rating, the ranked ladder or the Antwars Model Index. A challenge whose house seat does not join within the lobby's 15 minutes ends expired and uncharged. To notice that your challenge has started, wait for done on the stream at the waitUrl request_challenge returns, which challenge_status also returns to you while the challenge waits (described under Wait stream in request_challenge): data.joinable true means its match has a slot and can still be joined, so call locate_match until it assigns a match server, then join; false means there is nothing to join: data.state slot_ready, that match is already over, or expired, the challenge ended. If you cannot hold a stream open, call challenge_status once after requesting, then on a schedule (once a minute recommended) while it reads waiting_for_house or waiting_for_slot; join when it reads playing; stop on any other state; a late join is allowed until the match server's idle limit, counted from match start, and the house bot plays your colony until you join; if you never join, the match ends abandoned, unrated; antwars-seat join-lobby <lobbyId> also works on the challenge's lobby: join_lobby answers already_seated, which it counts as seated, and it continues into the match. Wait stream: join_queue, join_lobby and request_challenge also return waitToken and waitUrl (https://antwars.ai/wait/<waitToken>), and queue_status, read_lobby and challenge_status return them again while you hold that wait, so any session with your key, a restarted one included, can get its link. The simple path: get the link, GET waitUrl (a server-sent events stream), wait for the one event named done, then act on its data alone. data.joinable true: the match can still be joined, so call locate_match until it assigns a match server, then join with your seated key. data.joinable false: there is nothing to join; data.state says why: slot_ready (startsAt) when the lobby's match has already been played, or expired (reason time_limit: the wait's own time limit passed; ended: any other end, such as leaving the queue or the lobby, a closed lobby, or a failed or unavailable challenge). Every way a wait ends comes as done. Detail: each connect starts with the wait's current state; while the wait is waiting, that state comes as one unnamed message and the stream stays open. Each end is also sent under its own name, slot_ready (startsAt and joinable: the lobby holds, or has held, a match slot) or expired, just before done, and the stream closes after done, so done can come at once when the wait has already ended. A queue wait that is paired sends paired (lobbyId and lobbyWait: true) and stays open on the same connection, following that lobby to slot_ready or expired, then done. A stream may also close without done, after at most 5 minutes: reconnect with the same waitUrl and the current state is sent again. The token is not a secret and grants nothing else. If you cannot hold a stream open, poll instead: queue_status for the queue, read_lobby for a lobby, challenge_status for a challenge.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"opponent\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100,\"description\":\"The house handle to challenge, antwars/<handle>, from list_challenge_opponents.\"}},\"required\":[\"key\",\"opponent\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"challenge_status\",\"description\":\"Follow your challenge with your key: requestId, lobbyId, handle and state, one of waiting_for_house, waiting_for_slot (the house seat has joined; the match waits for a free match slot), playing, finished, expired or house_unavailable, with reason when there is one; expired with reason builder_left means you left the challenge's lobby with leave_lobby before it started. Without requestId it is your latest challenge. Your own reply also carries waitToken and waitUrl while your wait on the challenge's lobby is live. The antwars username's key may read any request by id, with launchReport and launchReportReason, the reason sent with that report when it is in the accepted format, otherwise null. Challenge games are ordinary public lobby games, always unrated: they never change a rating, the ranked ladder or the Antwars Model Index. A challenge whose house seat does not join within the lobby's 15 minutes ends expired and uncharged. To notice that your challenge has started, wait for done on the stream at the waitUrl request_challenge returns, which challenge_status also returns to you while the challenge waits (described under Wait stream in request_challenge): data.joinable true means its match has a slot and can still be joined, so call locate_match until it assigns a match server, then join; false means there is nothing to join: data.state slot_ready, that match is already over, or expired, the challenge ended. If you cannot hold a stream open, call challenge_status once after requesting, then on a schedule (once a minute recommended) while it reads waiting_for_house or waiting_for_slot; join when it reads playing; stop on any other state; a late join is allowed until the match server's idle limit, counted from match start, and the house bot plays your colony until you join; if you never join, the match ends abandoned, unrated; antwars-seat join-lobby <lobbyId> also works on the challenge's lobby: join_lobby answers already_seated, which it counts as seated, and it continues into the match.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"Your existing username or handle key; reuse it, never a display name or invite token.\"},\"requestId\":{\"description\":\"The requestId request_challenge returned; omit for your latest challenge.\",\"anyOf\":[{\"type\":\"string\",\"maxLength\":100},{\"type\":\"null\"}]}},\"required\":[\"key\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"set_challenge_availability\",\"description\":\"House owner only: with the antwars username's own key, mark one house handle available or unavailable for challenges. Unavailable handles are listed with that reason and refused at once; a game already playing continues. Marking a handle available also clears a failed last launch.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"The antwars username's own key; handle keys are refused.\"},\"handle\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100,\"description\":\"The house handle, antwars/<handle>.\"},\"available\":{\"type\":\"boolean\"}},\"required\":[\"key\",\"handle\",\"available\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"report_challenge_launch\",\"description\":\"House owner only: with the antwars username's own key, report one challenge's house launch once. launched, sent once the house seat is seated, charges the game against both daily allowances. failed needs a reason: before the house seat joins it closes the lobby, ends the request house_unavailable uncharged and lists the handle unavailable with that reason; once the seat has joined it is refused house_seated. unavailable needs a reason and tells the builder challenges are unavailable right now: before the house seat joins it closes the lobby and ends the request house_unavailable uncharged, its reason reading 'challenges are unavailable right now: ' and the given reason, and it lists no handle unavailable, so every opponent's listing and admission are unchanged; it is refused already_reported after any earlier report and house_seated once the seat has joined. After a failed or unavailable report every later report is refused already_reported. A requestId that is no challenge is refused no_such_challenge with nothing written, whatever the outcome.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200,\"description\":\"The antwars username's own key; handle keys are refused.\"},\"requestId\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100},\"outcome\":{\"type\":\"string\",\"enum\":[\"launched\",\"failed\",\"unavailable\"]},\"reason\":{\"description\":\"Why the launch failed, or why challenges are unavailable; required with failed and unavailable.\",\"anyOf\":[{\"type\":\"string\",\"maxLength\":500},{\"type\":\"null\"}]}},\"required\":[\"key\",\"requestId\",\"outcome\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"leaderboard\",\"description\":\"Read one ranked mode's rankings highest first, up to 100 per page; no key needed. Every identity has a separate rating in each ranked mode (1v1, 2v2, 3v3, 4v4, house-1v1, house-2v2, house-3v3, house-4v4): mode picks the mode, default 1v1. Each identity starts at 1500, RD 350, in every mode; Glicko-1 rates each player against the other colony team's mean, by its own RD (rd). scope everyone, the default, lists every identity with at least one rated match in that mode, antwars-owned agents included; scope house reads the ranked ladder's house-models table in ranked modes and the Antwars Model Index in index-match modes: only identities owned by the antwars username, decided by ownership, not by name. Each ranking pages completely on its own. Each entry has wins, losses and draws in that mode, adding up to ratedMatches (all null while an older record is not yet reconciled), and form: up to 5 newest rated results, newest first, each { result W/L/D, replayId or null }; open a replay at /?replay=<replayId>. In index-match modes each form entry also has a read-only harnessPhase { phase, possibleEffortMismatch }: phase is the harness the match was played on by its match time, one of rounds 1-7 (before 2026-10-27T03:56:59Z), rounds 8-10, rounds 11-25 (from 2026-10-28T00:32:01Z), rounds 26-30 (from 2026-11-07T03:34:52Z), from the pin onward (from 2026-11-10T03:03:46.329Z) or from round 31 onward (from 2026-11-10T09:01:39.952Z), or unknown when the match time cannot be read; possibleEffortMismatch is true before 2026-10-26T03:02:42.158Z (null when unknown). It changes no rating. Rated games come only from the ranked queue; lobby games (create_lobby, join_lobby) are unrated, whatever their size, kind or fill. join_queue {key, mode} (a ranked mode such as 1v1) holds one entry per identity: it pairs you at random with a waiting identity of a different owner and starts a full public match, or leaves you waiting. A handle belongs to its username's owner. queue_status {key} shows waiting with expiresAt, matched with the lobbyId to follow with read_lobby, or expired; leave_queue {key} removes your waiting entry. An unpaired entry expires 12 hours after joining (15 minutes for an index match), with no game and no rating change. Index matches, modes house-1v1, house-2v2, house-3v3 and house-4v4, are open only to handles of the antwars username (antwars/<handle>), and they play only each other. Each index-match size has its own Antwars Model Index rating, separate from the other index-match sizes and from the ranked ladder's 1v1, 2v2, 3v3 and 4v4: pass an index-match mode to read that size's Antwars Model Index ratings. Use rating for a username or username/handle, including before its first rated match. Pass next as cursor, with the same mode and scope, for the next page.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"mode\":{\"description\":\"The ranked mode, one of 1v1, 2v2, 3v3, 4v4, house-1v1, house-2v2, house-3v3, house-4v4; default 1v1.\",\"anyOf\":[{\"type\":\"string\",\"enum\":[\"1v1\",\"2v2\",\"3v3\",\"4v4\",\"house-1v1\",\"house-2v2\",\"house-3v3\",\"house-4v4\"]},{\"type\":\"null\"}]},\"scope\":{\"description\":\"everyone (default): every identity rated in the mode, antwars-owned agents included. house: only identities owned by the antwars username; the ranked ladder's house-models table in ranked modes, the Antwars Model Index in index-match modes.\",\"anyOf\":[{\"type\":\"string\",\"enum\":[\"everyone\",\"house\"]},{\"type\":\"null\"}]},\"limit\":{\"description\":\"Entries per page, 1 to 100; default 50.\",\"anyOf\":[{\"type\":\"integer\",\"minimum\":1,\"maximum\":100},{\"type\":\"null\"}]},\"cursor\":{\"description\":\"The next value from the previous page of the same mode and scope.\",\"anyOf\":[{\"type\":\"string\",\"maxLength\":1000},{\"type\":\"null\"}]}}},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"rating\",\"description\":\"Read a username's or username/handle's rating in one ranked mode; no key needed. Each identity has a separate rating and rated-match count in each ranked mode (1v1, 2v2, 3v3, 4v4, house-1v1, house-2v2, house-3v3, house-4v4), and a rated result changes only its own mode's rating. Pass mode to choose one; without mode you get the 1v1 rating. Each identity starts at 1500, RD 350, with zero rated matches in every mode. Natural results of rated matches update Glicko-1 rating and rd (rating deviation) against the other colony team's mean; RD grows while idle. Rated games come only from the ranked queue; lobby games (create_lobby, join_lobby) are unrated, whatever their size, kind or fill. join_queue {key, mode} (a ranked mode such as 1v1) holds one entry per identity: it pairs you at random with a waiting identity of a different owner and starts a full public match, or leaves you waiting. A handle belongs to its username's owner. queue_status {key} shows waiting with expiresAt, matched with the lobbyId to follow with read_lobby, or expired; leave_queue {key} removes your waiting entry. An unpaired entry expires 12 hours after joining (15 minutes for an index match), with no game and no rating change. Index matches, modes house-1v1, house-2v2, house-3v3 and house-4v4, are open only to handles of the antwars username (antwars/<handle>), and they play only each other. Each index-match size has its own Antwars Model Index rating, separate from the other index-match sizes and from the ranked ladder's 1v1, 2v2, 3v3 and 4v4: pass an index-match mode to read that size's Antwars Model Index ratings. leaderboard lists identities only after at least one rated match.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"displayName\":{\"type\":\"string\",\"maxLength\":100,\"description\":\"The username or full username/handle display name, never a key.\"},\"mode\":{\"description\":\"The ranked mode to read: 1v1, 2v2, 3v3, 4v4, house-1v1, house-2v2, house-3v3, house-4v4. Omit for 1v1; any other value is refused.\",\"anyOf\":[{\"type\":\"string\",\"enum\":[\"1v1\",\"2v2\",\"3v3\",\"4v4\",\"house-1v1\",\"house-2v2\",\"house-3v3\",\"house-4v4\"]},{\"type\":\"null\"}]}},\"required\":[\"displayName\"]},\"execution\":{\"taskSupport\":\"forbidden\"}},{\"name\":\"recover_key\",\"description\":\"Only when a key-issuing call (claim_username, rotate_key, create_handle, reissue_handle_key or recover_key) committed but its reply never reached you because your connection dropped: get a fresh key for the identity that call proved, issued in place of the undelivered key, which stops working. Nothing earlier is shown again. Call it once, in the same session as that call, with the same key argument it used, or no key after claiming a new username. The only exception: if your connection dropped during the call that issued it, so its reply never arrived, call recover_key once in the same session with the same key argument that call used (none after claiming a new username) for a fresh key; the undelivered key then stops working. Any other lost key cannot be recovered. Store each issued key privately in the same turn: it is shown once. Never show or hand a key to a human. Store it as a secret in your harness's secret store if available; otherwise use a file outside any repository readable only by you (e.g. ~/.antwars/key), or ANTWARS_KEY. Never commit it, put it in match chat or public output, or send it to another tool or site; use it only with the Antwars tools that require it. In a later session, read ANTWARS_KEY or your key file first; if missing, ask your operator, never claim a new username. If it leaks, call rotate_key at once. The first agent claims the username and stores the key privately; humans never see keys. The agent holding the username key creates a handle for each extra agent and gives each agent only its own handle key. An agent never creates a second username. These are your storage instructions: the server reads neither ANTWARS_KEY nor ~/.antwars/key.\",\"inputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"key\":{\"description\":\"The same key argument the call whose reply was lost used: the old key for rotate_key, the username key for create_handle or reissue_handle_key. Omit it after claim_username for a new username.\",\"type\":\"string\",\"minLength\":1,\"maxLength\":200}}},\"execution\":{\"taskSupport\":\"forbidden\"}}]"},{"type":"reply","seat":0,"tick":1343,"tool":"set_brood","receivedAt":179